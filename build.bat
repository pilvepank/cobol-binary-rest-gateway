cobc -free -x -Wall -Icopybooks tests\proto_test.cbl -o proto_test.exe
echo Building JSON Test...
cobc -free -x -Wall -Icopybooks tests\proto_json_test.cbl src\proto_json_parser.cbl -o proto_json_test.exe
