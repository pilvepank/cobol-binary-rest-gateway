cobc -free -x -Wall -Icopybooks tests\proto_jwt_test.cbl src\proto_jwt_auth.cbl -o proto_jwt_test.exe
echo Building Metrics Test...
cobc -free -x -Wall -Icopybooks tests\proto_metrics_test.cbl src\proto_metrics_exporter.cbl -o proto_metrics_test.exe
echo Building CORS Test...
cobc -free -x -Wall -Icopybooks tests\proto_cors_test.cbl src\proto_cors_validator.cbl -o proto_cors_test.exe
echo Building TLV Test...
cobc -free -x -Wall -Icopybooks tests\proto_tlv_test.cbl src\proto_tlv_encoder.cbl -o proto_tlv_test.exe
echo Building Circuit Breaker Test...
cobc -free -x -Wall -Icopybooks tests\proto_circuit_test.cbl src\proto_circuit_breaker.cbl -o proto_circuit_test.exe
echo Building HTTP Parser Test...
cobc -free -x -Wall -Icopybooks tests\proto_http_test.cbl src\proto_http_parser.cbl -o proto_http_test.exe
